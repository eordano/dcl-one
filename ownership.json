{
  "areas": [
    {
      "id": "platform",
      "description": "Default ownership, build contracts and repository checks",
      "owners": [
        "@decentraland/infra"
      ],
      "paths": [
        "*"
      ]
    },
    {
      "id": "infrastructure",
      "description": "Foundation infrastructure and review policy",
      "owners": [
        "@decentraland/infra"
      ],
      "paths": [
        "/infra/",
        "/.github/",
        "/ownership.json"
      ]
    },
    {
      "id": "catalyst-runtime",
      "description": "Shared Rust workspace and API process",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/"
      ]
    },
    {
      "id": "content",
      "description": "content domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/content/"
      ]
    },
    {
      "id": "explore",
      "description": "explore domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/explore/"
      ]
    },
    {
      "id": "worlds",
      "description": "worlds domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/worlds/"
      ]
    },
    {
      "id": "social",
      "description": "social domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/social/",
        "/tooling/social-*.cjs",
        "/tooling/social-captures.json",
        "/tooling/tests/social-*.test.cjs"
      ]
    },
    {
      "id": "shop",
      "description": "shop domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/shop/"
      ]
    },
    {
      "id": "builder",
      "description": "builder domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/builder/"
      ]
    },
    {
      "id": "camera-reel",
      "description": "camera-reel domain; compiled into the shared Catalyst runtime",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/camera-reel/"
      ]
    },
    {
      "id": "shared-backend",
      "description": "Shared backend libraries with enforced module layers",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/library/dcl-auth/",
        "/library/dcl-http/",
        "/library/catalyst-api/",
        "/services/catalyst/fed/",
        "/services/catalyst/jobs/",
        "/services/catalyst/shared/",
        "/services/catalyst/config/",
        "/services/catalyst/storage/",
        "/services/catalyst/price/",
        "/services/catalyst/chain-index/",
        "/services/catalyst/land-authz/",
        "/services/catalyst/testing/"
      ]
    },
    {
      "id": "protocol",
      "description": "The .proto contract: the one proto source the Explorer, the SDK and the services build from",
      "owners": [
        "@decentraland/client",
        "@decentraland/apis"
      ],
      "paths": [
        "/library/protocol/"
      ]
    },
    {
      "id": "sdk",
      "description": "The creator SDK packages (@dcl/sdk, ecs, react-ecs, js-runtime, sdk-commands, playground-assets)",
      "owners": [],
      "paths": [
        "/library/js-sdk-toolchain/",
        "/library/hashing/",
        "/.github/workflows/sdk.yml"
      ]
    },
    {
      "id": "database",
      "description": "One schema bootstrap, migrations and database invariants",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/schemas/",
        "/services/catalyst/db/"
      ]
    },
    {
      "id": "creator-sdk",
      "description": "Creator SDK and preview tooling; selected separately from the node workspace build",
      "owners": [
        "@decentraland/client"
      ],
      "paths": [
        "/apps/dcl-scene-cli/",
        "/library/dcl-scene-authoring/",
        "/library/dcl-scene-build/",
        "/library/dcl-preview-tunnel/",
        "/library/dcl-preview-tunnel-protocol/"
      ]
    },
    {
      "id": "comms",
      "description": "Communication and multiplayer crate (layer 8): the archipelago connector, the gatekeeper (admission, moderation, voice, streaming, LiveKit webhook, room events), live presence and Pulse",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/comms/",
        "/library/vendor/rusty_enet/",
        "/library/dcl-livekit-token/"
      ]
    },
    {
      "id": "pulse",
      "description": "Independent realtime process (catalyst pulse); its code is comms::pulse, listed after comms so the narrower path wins",
      "owners": [
        "@decentraland/apis"
      ],
      "paths": [
        "/services/catalyst/comms/src/pulse/"
      ]
    },
    {
      "id": "web",
      "description": "Sites SSR and shared React UI",
      "owners": [
        "@decentraland/web-applications"
      ],
      "paths": [
        "/apps/sites/",
        "/apps/ui3/",
        "/library/ui/"
      ]
    },
    {
      "id": "async",
      "description": "Shared asynchronous waiting and backoff utilities",
      "owners": [
        "@decentraland/web-applications",
        "@decentraland/apis"
      ],
      "paths": [
        "/library/async/"
      ]
    },
    {
      "id": "shop-ui",
      "description": "Shop product UI and its portable core",
      "owners": [
        "@decentraland/web-applications"
      ],
      "paths": [
        "/apps/ui3/src/shop/",
        "/library/shop/",
        "/apps/sites/src/routes/shop/",
        "/tooling/shop-parity/",
        "/tooling/shop-trade-journey/"
      ]
    },
    {
      "id": "explore-ui",
      "description": "Discovery frontend",
      "owners": [
        "@decentraland/web-applications"
      ],
      "paths": [
        "/apps/ui3/src/explorer/"
      ]
    },
    {
      "id": "creator-ui",
      "description": "Creator editor (web) and the Creator Hub desktop workspace (Electron app, inspector, asset packs)",
      "owners": [
        "@decentraland/web-applications"
      ],
      "paths": [
        "/apps/ui3/src/editor/",
        "/apps/ui3/editor-scene/",
        "/apps/creator-hub/",
        "/.github/workflows/creator-hub-*.yml",
        "/.github/actions/creator-hub-*/"
      ]
    },
    {
      "id": "explorer-client",
      "description": "Explorer source, its HUD UI and page core, local app builds, component workflows, the tools that rebuild and prove its sources and select its CI, and its Nix package",
      "owners": [
        "@decentraland/client"
      ],
      "paths": [
        "/rendering/bevy-explorer/",
        "/library/ui/apps/hud/",
        "/library/explorer-core/",
        "/apps/bevy-explorer/",
        "/.github/workflows/bevy-explorer-*.yml",
        "/.github/actions/bevy-explorer-*/",
        "/tooling/bevy-*.py",
        "/tooling/patched-sources.py",
        "/tooling/vendor-provenance.py",
        "/tooling/tests/test_bevy_*.py",
        "/infra/packages/bevy-explorer.nix"
      ]
    },
    {
      "id": "explorer-rust",
      "description": "Explorer Rust source, its workspace manifest, build script and Cargo configuration, the Rust harness crates, the vendored Rust crates, and the upstream references and patch series of Bevy and the forked crates",
      "owners": [
        "@robtfm"
      ],
      "paths": [
        "/rendering/bevy-explorer/source/crates/",
        "/rendering/bevy-explorer/source/src/",
        "/rendering/bevy-explorer/source/Cargo.toml",
        "/rendering/bevy-explorer/source/Cargo.lock",
        "/rendering/bevy-explorer/source/build.rs",
        "/rendering/bevy-explorer/source/.cargo/config.toml",
        "/rendering/bevy-explorer/source/local-harness/benchmark/",
        "/rendering/bevy-explorer/source/local-harness/presence/harness-util/",
        "/rendering/bevy-explorer/source/vendor/",
        "/rendering/bevy-explorer/vendor/",
        "/rendering/bevy-explorer/patches/"
      ]
    },
    {
      "id": "uuav-native",
      "description": "UUAV native video player: the client crate the Explorer links, the sandboxed uuav-helper, the committed runtime set and its lock, the native build and verification workflows",
      "owners": [
        "@decentraland/client"
      ],
      "paths": [
        "/library/uuav/",
        "/tooling/uuav/",
        "/tooling/native-lock/",
        "/.github/workflows/uuav-native.yml",
        "/.github/workflows/uuav-verify.yml"
      ]
    },
    {
      "id": "quality",
      "description": "Journey evidence, conformance and checks",
      "owners": [
        "@decentraland/qa"
      ],
      "paths": [
        "/services/catalyst/tests/"
      ]
    },
    {
      "id": "documentation",
      "description": "Architecture, compatibility evidence and measured performance",
      "owners": [
        "@decentraland/infra"
      ],
      "paths": [
        "/docs/"
      ]
    },
    {
      "id": "ui-library-workflow",
      "description": "The shared UI library CI workflow that runs the provenance checks; owned by the library team together with infra, which owns the other workflows",
      "owners": [
        "@decentraland/web-applications",
        "@decentraland/infra"
      ],
      "paths": [
        "/.github/workflows/ui-library.yml"
      ]
    }
  ]
}
