From 4a48b6bd3b85c87e26d0f80c837cedfc6c4ec34d
Subject: Feature-gate the egui console UI behind a default-on 'ui' feature
Origin: https://github.com/robtfm/bevy-console/commit/4a48b6bd3b85c87e26d0f80c837cedfc6c4ec34d
Date: 2026-07-06T18:15:50+01:00

With default-features = false only the command/print event plumbing is
built, so consumers that never open the console window (bevy-explorer
pipes commands through chat) can drop bevy_egui from their dependency
tree entirely.
---
diff --git a/Cargo.toml b/Cargo.toml
index 17b64d4426706662afccc01716bb3f572b26f654..7ec469d2049e18331c6ee473b936fd39f0d1e401 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -16,12 +16,17 @@ bevy = { version = "0.16", default-features = false, features = [
 ] }
 clap = { version = "4.5", features = ["derive"] }
 bevy_console_derive = { path = "./bevy_console_derive", version = "0.5.0" }
-bevy_egui = { version = "0.34", default-features = false, features = [ "render", "default_fonts" ] }
+bevy_egui = { version = "0.34", default-features = false, features = [ "render", "default_fonts" ], optional = true }
 shlex = "1.3"
 ansi-parser = "0.9"
 strip-ansi-escapes = "0.2"
 trie-rs = "0.2"
 
+[features]
+default = ["ui"]
+# the egui console window; without it only the command/print event plumbing is built
+ui = ["dep:bevy_egui"]
+
 [dev-dependencies]
 bevy = { version = "0.16", features = ["std", "bevy_log"] }
 color-print = { version = "0.3" }
