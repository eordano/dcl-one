 asset_processor = []
 watch = []
 trace = []
-wasm_threaded_loader = ["async-channel", "spin"]
+wasm_threaded_loader = ["async-channel", "spin", "dep:gloo-timers"]
 
 [dependencies]
 bevy_app = { path = "../bevy_app", version = "0.16.1" }
@@ -68,6 +68,7 @@ web-sys = { version = "0.3", features = [
 ] }
 wasm-bindgen-futures = "0.4"
 js-sys = "0.3"
+gloo-timers = { version = "0.3", features = ["futures"], optional = true }
 uuid = { version = "1.13.1", default-features = false, features = ["js"] }
 bevy_app = { path = "../bevy_app", version = "0.16.1", default-features = false, features = [
   "web",
