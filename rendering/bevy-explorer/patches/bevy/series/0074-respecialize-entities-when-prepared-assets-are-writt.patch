From 255aa003e14d30602b99c6a691a0183f26d707e9
Subject: respecialize entities when prepared assets are written render-world-only
Origin: https://github.com/robtfm/bevy/commit/255aa003e14d30602b99c6a691a0183f26d707e9
Date: 2026-08-09T17:16:40+01:00

Prepared assets can change with no main-world asset event: prepare_assets
swaps a fallback asset for the real material once it can be prepared, and
meshes keep serving the previous RenderMesh while a deferred re-upload is
pending, so specialization consumes the entity tick against the old data.
Nothing announced these writes to the holding entities: the pipeline
cached by specialize_material_meshes went stale, and queue_material_meshes
paired it with the current material state - placing e.g. a fallback blend
pipeline (two color targets under depth of field) into the alpha-mask bin,
whose pass has one target, tripping wgpu validation.

Record a per-asset write tick in RenderAssets and treat it as a third
source of specialization-need alongside the view and entity ticks; the
entity/asset join happens naturally at the specialize check, so entities
that are off-screen when the write happens pick it up on their next visit.
When an entity needs respecialization but its assets aren't available to
rebuild the pipeline, remove the cache entry so queue skips it rather than
pairing the current material with an outdated pipeline.
---
diff --git a/crates/bevy_pbr/src/material.rs b/crates/bevy_pbr/src/material.rs
index 475d2dd158e08ba4ac1a48479f04bd24533d20f3..cce4b6f3a4e6dbfe681a6879ad61a80b97dfb0f5 100644
--- a/crates/bevy_pbr/src/material.rs
+++ b/crates/bevy_pbr/src/material.rs
@@ -1245,25 +1245,45 @@ pub fn specialize_material_meshes<M: Material>(
                 continue;
             };
             let entity_tick = entity_specialization_ticks.get(visible_entity).unwrap();
-            let last_specialized_tick = view_specialized_material_pipeline_cache
+            // Asset write ticks are a third source of specialization-need:
+            // prepared assets can change render-world-only, with no view or
+            // entity tick to announce it (a fallback material replaced by the
+            // real one, a deferred mesh re-upload landing after we
+            // specialized against the previous version).
+            let asset_written = |write_tick: Option<Tick>, tick: &Tick| {
+                write_tick
+                    .is_some_and(|write_tick| write_tick.is_newer_than(*tick, ticks.this_run()))
+            };
+            let needs_specialization = view_specialized_material_pipeline_cache
                 .get(visible_entity)
-                .map(|(tick, _)| *tick);
-            let needs_specialization = last_specialized_tick.is_none_or(|tick| {
-                view_tick.is_newer_than(tick, ticks.this_run())
-                    || entity_tick.is_newer_than(tick, ticks.this_run())
-            });
+                .is_none_or(|(tick, _)| {
+                    view_tick.is_newer_than(*tick, ticks.this_run())
+                        || entity_tick.is_newer_than(*tick, ticks.this_run())
+                        || asset_written(render_materials.write_tick(material_asset_id), tick)
+                        || asset_written(
+                            render_meshes.write_tick(mesh_instance.mesh_asset_id),
+                            tick,
+                        )
+                });
             if !needs_specialization {
                 continue;
             }
+            // If the pipeline can't be rebuilt now, remove the outdated cache
+            // entry so the entity is skipped at queue rather than paired with
+            // the current material state (the phase may differ, and with it
+            // the pass color targets).
             let Some(mesh) = render_meshes.get(mesh_instance.mesh_asset_id) else {
+                view_specialized_material_pipeline_cache.remove(visible_entity);
                 continue;
             };
             let Some(material) = render_materials.get(material_asset_id) else {
+                view_specialized_material_pipeline_cache.remove(visible_entity);
                 continue;
             };
             let Some(material_bind_group) =
                 material_bind_group_allocator.get(material.binding.group)
             else {
+                view_specialized_material_pipeline_cache.remove(visible_entity);
                 continue;
             };
 
@@ -1315,6 +1335,7 @@ pub fn specialize_material_meshes<M: Material>(
                 Ok(id) => id,
                 Err(err) => {
                     error!("{}", err);
+                    view_specialized_material_pipeline_cache.remove(visible_entity);
                     continue;
                 }
             };
