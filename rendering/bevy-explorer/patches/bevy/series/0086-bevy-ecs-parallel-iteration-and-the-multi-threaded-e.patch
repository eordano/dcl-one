From 840592f493398b0107ff795a21bac8f8d793988b
Subject: bevy_ecs: parallel iteration and the multi-threaded executor on the web under web-worker
Origin: https://github.com/robtfm/bevy/commit/840592f493398b0107ff795a21bac8f8d793988b
Date: 2026-09-22T23:04:15+01:00

Every "is this target multi-threaded" gate in bevy_ecs was written as
"not wasm32". With the multi-threaded TaskPool available on the web under
`bevy_tasks/web-worker`, add the same feature here and widen those gates
to "not wasm32, or web-worker": the schedule executor
defaults to MultiThreaded and query and event parallel iteration batch
over the ComputeTaskPool, as on native.

`bevy_render/web-worker` and `bevy_winit/web-worker` now enable
`bevy_ecs/web-worker` too, so the feature means the same thing whichever
crate turns it on.
---
diff --git a/crates/bevy_ecs/Cargo.toml b/crates/bevy_ecs/Cargo.toml
index 07e227de1a4e83ffa559f4e8a03a92b7b366b5bc..6f239149795acb8f0d2cb1a1a83eb6bcc2f378d4 100644
--- a/crates/bevy_ecs/Cargo.toml
+++ b/crates/bevy_ecs/Cargo.toml
@@ -19,6 +19,10 @@ default = ["std", "bevy_reflect", "async_executor", "backtrace"]
 ## multiple threads whenever possible.
 multi_threaded = ["bevy_tasks/multi_threaded", "dep:arrayvec"]
 
+## The app runs on a web worker over shared memory: the multi-threaded executor and
+## parallel iteration are used there as on native.
+web-worker = ["bevy_tasks/web-worker"]
+
 ## Adds serialization support through `serde`.
 serialize = [
   "dep:serde",
