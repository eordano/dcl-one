+impl<T> Drop for Task<T> {
+    fn drop(&mut self) {
+        if let Some(abort) = &self.abort {
+            abort.abort();
+            if matches!(self.receiver.try_recv(), Ok(None)) {
+                tracing::debug!(
+                    "dropped a pending task yielding `{}`, aborting it",
+                    type_name::<T>()
+                );
+            }
+        }
+    }
+}
