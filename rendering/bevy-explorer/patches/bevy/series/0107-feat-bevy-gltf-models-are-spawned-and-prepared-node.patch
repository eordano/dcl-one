+        world: &mut World,
+        scene: &Scene,
+        type_registry: &TypeRegistry,
+        (handle, instance_id, parent): (Handle<Scene>, InstanceId, Option<Entity>),
+    ) -> Result<Self, SceneSpawnError> {
