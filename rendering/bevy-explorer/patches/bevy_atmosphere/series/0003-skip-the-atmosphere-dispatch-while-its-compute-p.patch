From df14ad8f2949f558f9503ead4ce2f74e72032beb
Subject: Skip the atmosphere dispatch while its compute pipeline is absent
Origin: https://github.com/robtfm/bevy_atmosphere/commit/df14ad8f2949f558f9503ead4ce2f74e72032beb
Date: 2026-10-13T12:06:16+01:00

The node unwrapped the compute pipeline, which is None while the
shader recompiles after a hot reload, so a shader edit took the
whole app down. The sky keeps its last cubemap for those frames.
---
diff --git a/src/pipeline.rs b/src/pipeline.rs
index a0a9649660c215283062e36b6124b2c2228e5203..3a32023938a2aa5ffe0246ffe250ae473a236249 100644
--- a/src/pipeline.rs
+++ b/src/pipeline.rs
@@ -507,6 +507,12 @@ impl render_graph::Node for AtmosphereNode {
                         data.pipeline
                     };
 
+                    // the pipeline is absent while its shader recompiles after a hot reload
+                    let Some(update_pipeline) = pipeline_cache.get_compute_pipeline(pipeline)
+                    else {
+                        return Ok(());
+                    };
+
                     let mut pass = render_context.command_encoder().begin_compute_pass(
                         &ComputePassDescriptor {
                             label: Some("atmosphere_pass"),
@@ -517,7 +523,6 @@ impl render_graph::Node for AtmosphereNode {
                     pass.set_bind_group(0, &bind_groups.0, &[]);
                     pass.set_bind_group(1, &bind_groups.1, &[]);
 
-                    let update_pipeline = pipeline_cache.get_compute_pipeline(pipeline).unwrap();
                     pass.set_pipeline(update_pipeline);
                     pass.dispatch_workgroups(
                         settings.resolution / WORKGROUP_SIZE / 8,
