diff --git a/src/audio_output.rs b/src/audio_output.rs
index 762996bfcdb29f603fd4ec67784462a0f9c847b2..c7a3159ed8d414937450666148f66022fbf1a40b 100644
--- a/src/audio_output.rs
+++ b/src/audio_output.rs
@@ -25,8 +25,8 @@ use std::collections::HashMap;
 ///
 /// This struct holds the [`AudioManager`] to play audio through. It also
 /// keeps track of all audio instance handles and which sounds are playing in which channel.
-pub(crate) struct AudioOutput<B: Backend = DefaultBackend> {
-    manager: Option<AudioManager<B>>,
+pub struct AudioOutput<B: Backend = DefaultBackend> {
+    pub manager: Option<AudioManager<B>>,
     instances: HashMap<Channel, Vec<Handle<AudioInstance>>>,
     channels: HashMap<Channel, ChannelState>,
 }
diff --git a/src/instance.rs b/src/instance.rs
index deeee904e0eb043d3eb172ff74a729af667cdc69..c40fd362e778ca8f79dba6f1660842ffe2423fa3 100644
--- a/src/instance.rs
+++ b/src/instance.rs
@@ -64,6 +64,14 @@ impl AudioInstance {
     pub fn seek_by(&mut self, amount: f64) {
         self.handle.seek_by(amount);
     }
+
+    /// set loop
+    pub fn set_loop(&mut self, looped: bool) -> Option<AudioCommandError> {
+        self.handle
+            .set_loop_region(looped.then_some(Region::default()))
+            .err()
+            .map(|kira_error| kira_error.into())
+    }
 }
 
