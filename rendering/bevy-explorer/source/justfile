# dev entry points. `just --list` for a summary.
# node recipes assume node 22+ on PATH (nvm users: the interactive shell's PATH is inherited).

# recipe arguments reach the shell as "$@", so a realm url with `&` or spaces stays one argument
set positional-arguments

# the wasm rustflags (+atomics, ...) need nightly; same pin as apps/bevy-explorer/build-web.py
wasm_toolchain := "nightly-2026-04-15"

# the bridge scene's package manager; a shell with pnpm on its PATH sets PNPM=pnpm (nix develop .#wasm does)
pnpm := env_var_or_default("PNPM", "corepack pnpm@11.27.0")

# nixos: cef's bundled libvulkan.so.1 can't find the system's vulkan drivers without this
nixos_vulkan := if path_exists("/run/opengl-driver/share") == "true" { 'XDG_DATA_DIRS="/run/opengl-driver/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"' } else { "" }

# build the wasm engine into deploy/web/engine/pkg, then serve the react-web page (which hosts
# the engine + live bridge-scene preview) and open a browser at the vite dev server.
wasm: ts-bindings
    RUSTUP_TOOLCHAIN={{wasm_toolchain}} wasm-pack build --target web --out-dir ./deploy/web/engine/pkg --no-default-features --features="livekit,social"
    rm -f ./deploy/web/engine/pkg/.gitignore
    WASM_SIZE=$(wc -c < ./deploy/web/engine/pkg/webgpu_build_bg.wasm) && echo "{\"wasmSize\":${WASM_SIZE}}" > ./deploy/web/engine/pkg/manifest.json
    RUSTUP_TOOLCHAIN={{wasm_toolchain}} wasm-pack build crates/dcl_scene_wasm --target web --out-dir ../../deploy/web/engine/pkg-scene --no-default-features
    rm -f ./deploy/web/engine/pkg-scene/.gitignore
    # inline the scene runtime's glue into the sandbox worker — the engine loads
    # pkg/sandbox_worker.bundle.js, so this must re-run on every wasm build.
    npx --yes esbuild@0.28.1 ./deploy/web/engine/sandbox_worker.js --bundle --format=esm --log-level=error --outfile=./deploy/web/engine/pkg/sandbox_worker.bundle.js
    cd react-web && npm install
    cd react-web/bridge-scene && {{pnpm}} install --frozen-lockfile --ignore-scripts && {{pnpm}} --filter @dcl/hashing build
    cd react-web && npm run dev -- --open

# regenerate the TypeScript bindings for the ~system/BevyExplorerApi boundary from the Rust
# structs in crates/system_api_types, into library/explorer-core/engine/generated (+ a barrel index.ts).
ts-bindings:
    ./scripts/gen-ts-bindings.sh

# bundle the react HUD page + bridge scene into assets/ (the files native runs from).
# ts-bindings first so the TS the page + bridge scene import is regenerated from the Rust structs.
bundle-native: ts-bindings
    cd react-web && npm install
    cd react-web/bridge-scene && {{pnpm}} install --frozen-lockfile --ignore-scripts && {{pnpm}} --filter @dcl/hashing build
    cd react-web && npm run bundle:native
    mkdir -p target && touch target/.bundle-native-stamp

# bundle only if react-web, its checked shared dependency graph,
# or the Rust structs behind its generated types changed since the last successful bundle
_bundle-native-if-stale:
    #!/usr/bin/env sh
    set -eu
    stamp=target/.bundle-native-stamp
    status=0
    # a stock Windows has only a Microsoft Store stub for python3; its installed Python is `python`
    python=python3
    "$python" -c '' >/dev/null 2>&1 || python=python
    "$python" ../../../tooling/hud_shared_inputs.py --root ../../.. --newer-than "$stamp" || status=$?
    [ "$status" -le 1 ] || exit "$status"
    if [ "$status" -eq 0 ] \
       && [ -f "$stamp" ] && [ -f assets/react-hud/app.html ] \
       && [ -f assets/bridge-scene/BevyExplorerUI/about ] \
       && [ -z "$(find react-web crates/system_api_types -name node_modules -prune -o -type f -newer "$stamp" -print | head -n 1)" ]; then
        echo "HUD sources unchanged; skipping bundle (just bundle-native to force)"
    else
        just bundle-native
    fi

# build + run the native app (debug) with the CEF react HUD. extra args pass through, e.g.
#   just native-debug --realm https://realm-provider-ea.decentraland.org/main
native-debug *ARGS: _sources _bundle-native-if-stale
    cargo build --package dcl_deno_ipc
    cargo build --bin decentra-bevy-cef
    {{nixos_vulkan}} cargo run --bin decentra-bevy -- "$@"

# build + run the native app (release) with the CEF react HUD
native-release *ARGS: _sources _bundle-native-if-stale
    cargo build --release --package dcl_deno_ipc
    cargo build --release --bin decentra-bevy-cef
    {{nixos_vulkan}} cargo run --release --bin decentra-bevy -- "$@"

# cargo reads bevy and the forked crates from ../bevy and ../forks, which are not tracked: write the
# ones that are missing or stale from ../patches. scripts/gen-ts-bindings.sh calls the same script
# for the wasm and ts-bindings recipes.
_sources:
    ./scripts/patched-sources.sh

# one-time per machine: fetch the CEF framework. only macos falls back to it at runtime; on linux
# and windows the loader must find it (LD_LIBRARY_PATH on linux, see readme.md)
setup-cef:
    cargo install export-cef-dir --version "139.8.0+139.0.40"
    export-cef-dir --force $HOME/.local/share/cef
